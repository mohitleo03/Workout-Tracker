NODE_ENV=development
PORT=4000

# Interface to bind to. 0.0.0.0 lets the Android emulator (10.0.2.2), a phone on
# the same Wi-Fi, and localhost all reach the API. Use 127.0.0.1 to restrict it
# to this machine only.
HOST=0.0.0.0

# Where the API is mounted. If you change this, update API_BASE_URL in the
# mobile app's .env to match.
API_PREFIX=/api/v1
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/workout_tracker?retryWrites=true&w=majority
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=90d
CORS_ORIGIN=*

DNS_SERVERS=
